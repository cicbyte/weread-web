# WeRead Plus 配置模板
# 使用: cp config.yaml.example config.yaml

server:
  address: ":8000"
  logPath: "log/server"
  logStdout: true
  errorStack: true
  errorLogEnabled: true
  errorLogPattern: "error-{Ymd}.log"
  accessLogEnabled: true
  accessLogPattern: "access-{Ymd}.log"

logger:
  path: "log/run"
  file: "{Y-m-d}.log"
  level: "all"
  stdout: true

database:
  default:
    link: "sqlite::@file(db/weread_plus.db)"
    # MySQL
    #link: "mysql:root:123456@tcp(172.17.0.1:3306)/weread_plus?charset=utf8mb4&parseTime=true&loc=Local"

# 微信读书 API 网关
weread:
  gateway: "https://i.weread.qq.com/api/agent/gateway"
  skillVersion: "1.0.3"

# JWT 认证
auth:
  jwtSecret: "weread-plus-jwt-secret-change-me"
  jwtExpire: 168  # 7天（小时）
  jwtRefreshExpire: 720  # 30天（小时）

storage:
  type: "local"
  local:
    basePath: "uploads"
    baseURL: "/uploads"
  image:
    maxFileSize: 10485760
    pathPrefix: "exports"

search:
  enabled: false
  # Meilisearch 全文搜索
  #enabled: true
  #meilisearch:
  #  address: "http://172.17.0.1:7700"
