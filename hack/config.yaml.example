
# CLI tool, only in development environment.
# https://goframe.org/docs/cli
gfcli:
  gen:
    dao:
      - link: "mysql:root:123456@tcp(127.0.0.1:3306)/weread-web"
        descriptionTag: true

  docker:
    build: "-a amd64 -s linux -p temp -ew"
    tagPrefixes:
      - weread-web

  build:
    name:     "weread-web"
    arch:     "amd64"
    system:   "linux"
    mod:      "none"
    cgo:      0
    packSrc:  "resource"
    version:  ""
    output:   "./bin"
    extra:    ""
